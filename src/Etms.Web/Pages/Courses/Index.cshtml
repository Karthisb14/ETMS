@page
@model Etms.Web.Pages.Courses.IndexModel
@{
    ViewData["Title"] = "Courses";
}

<h1>Courses</h1>

<p>
    <a asp-page="./Edit" class="btn btn-primary">Add course</a>
</p>

@if (Model.Courses.Count == 0)
{
    <p>No courses yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Code</th>
                <th>Course</th>
                <th>Description</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var course in Model.Courses)
            {
                <tr>
                    <td>@course.Code</td>
                    <td>@course.Name</td>
                    <td>@course.Description</td>
                    <td>
                        <a asp-page="./Edit" asp-route-id="@course.CourseId">Edit</a> |
                        <form method="post" asp-page-handler="Delete" asp-route-id="@course.CourseId" style="display:inline"
                              onsubmit="return confirm('Are you sure you wish to delete this record?');">
                            <button type="submit" class="btn btn-link p-0 align-baseline">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
