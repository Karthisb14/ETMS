@page "{id:int?}"
@model Etms.Web.Pages.Courses.EditModel
@{
    ViewData["Title"] = Model.Course.CourseId == 0 ? "Add course" : "Edit course";
}

<h1>@ViewData["Title"]</h1>

<form method="post">
    <input type="hidden" asp-for="Course.CourseId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group mb-3">
        <label asp-for="Course.Code" class="form-label"></label>
        <input asp-for="Course.Code" class="form-control" maxlength="4" />
        <span asp-validation-for="Course.Code" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Course.Name" class="form-label"></label>
        <input asp-for="Course.Name" class="form-control" />
        <span asp-validation-for="Course.Name" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Course.Description" class="form-label"></label>
        <textarea asp-for="Course.Description" class="form-control"></textarea>
        <span asp-validation-for="Course.Description" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
