@page
@model Etms.Web.Pages.Employees.IndexModel
@{
    ViewData["Title"] = "Employees";
}

<h1>Employees</h1>

@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-page="./Edit" class="btn btn-primary">Add employee</a>
    </p>
}

@if (Model.Employees.Count == 0)
{
    <p>No employees yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Hire date</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employee in Model.Employees)
            {
                <tr>
                    <td>@employee.Name</td>
                    <td>@employee.HireDate.ToShortDateString()</td>
                    <td>
                        @if (User.IsInRole("Admin"))
                        {
                            <span>
                                <a asp-page="./Edit" asp-route-id="@employee.EmployeeId">Edit</a> |
                                <form method="post" asp-page-handler="Delete" asp-route-id="@employee.EmployeeId" style="display:inline"
                                      onsubmit="return confirm('Are you sure you wish to delete this record?');">
                                    <button type="submit" class="btn btn-link p-0 align-baseline">Delete</button>
                                </form>
                            </span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
