@page "{employeeId:int}"
@model Etms.Web.Pages.Employees.AssignCourseModel
@{
    ViewData["Title"] = "Assign course";
}

<h1>@ViewData["Title"]</h1>

<form method="post">
    <input type="hidden" asp-for="Assignment.EmployeeCourseId" />
    <input type="hidden" asp-for="EmployeeId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group mb-3">
        <label asp-for="Assignment.CourseId" class="form-label">Course</label>
        <select asp-for="Assignment.CourseId" asp-items="Model.CourseOptions" class="form-select"></select>
        <span asp-validation-for="Assignment.CourseId" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="Assignment.IsPass" class="form-check-input" />
        <label asp-for="Assignment.IsPass" class="form-check-label">Passed</label>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Assignment.Note" class="form-label"></label>
        <textarea asp-for="Assignment.Note" class="form-control"></textarea>
        <span asp-validation-for="Assignment.Note" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="./Edit" asp-route-id="@Model.EmployeeId" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
