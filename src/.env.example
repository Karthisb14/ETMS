# Copy to .env (gitignored) and set real values before running docker compose.
ETMS_DB_PASSWORD=change-me-to-a-strong-password-12+chars

# Bootstraps the first Admin account (self-registration is invite-only — see README).
# Rotate this password immediately after first login; these vars only take effect
# when no user with this email exists yet.
ETMS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
ETMS_BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-strong-password-12+chars
